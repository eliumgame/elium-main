# Clés des fournisseurs (seules celles réellement utilisées sont nécessaires).
# Scaleway : console.scaleway.com → IAM → Clés d'API → « Secret key ».
SCW_SECRET_KEY=
# Mistral (secours) : console.mistral.ai → API Keys.
MISTRAL_API_KEY=
# OVHcloud AI Endpoints (facultatif).
OVH_AI_ENDPOINTS_TOKEN=

LOG_LEVEL=info
