# --- Elium Drive Entreprise — server configuration -------------------------
# Copy to .env for local dev. In production these are injected by docker-compose.

# HTTP
PORT=8787
HOST=0.0.0.0
# Comma-separated list of allowed web origins (the web-studio app). En dev,
# `npm run dev` de web-studio sert sur le port 3000 (fixé dans vite.config.ts,
# PAS le 5173 générique de Vite) et proxifie déjà /api en même origine vers ce
# serveur — donc cette liste n'est pas consultée pour ce trafic. Elle compte
# quand même pour les cérémonies WebAuthn (l'origine attendue vient d'ici, cf.
# WEBAUTHN_RP_ID plus bas) et pour le build de preview Playwright (port 3100).
CORS_ORIGINS=http://localhost:3100,http://localhost:3000

# Postgres
DATABASE_URL=postgres://elium:elium@localhost:5432/elium

# Access-token signing secret (HMAC-SHA256). MUST be long & random in prod.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TOKEN_SECRET=dev-only-change-me-please-32bytes-minimum-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Blob storage: "fs" (local volume) or "s3" (MinIO / S3-compatible)
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./data/blobs
# S3 / MinIO (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=elium-blobs
S3_ACCESS_KEY=elium
S3_SECRET_KEY=elium-secret
S3_FORCE_PATH_STYLE=true

# Limits
MAX_BLOB_BYTES=2147483648
MAX_JSON_BYTES=1048576

# --- Variables additionnelles (lues par server/src/config.ts sauf mention contraire) ---

# Bascule dev/prod. Active les vérifications de sécurité de production dans
# config.ts (TOKEN_SECRET doit faire >= 32 caractères et ne pas contenir une
# valeur d'exemple type "change-me" ; DATABASE_URL ne doit plus utiliser un
# mot de passe par défaut). DOIT valoir exactement "production" en
# déploiement réel, sinon ces vérifications sont silencieusement désactivées.
# Toute autre valeur (ou absence) est traitée comme développement.
NODE_ENV=development

# `trustProxy` Fastify : qui a le droit de fournir X-Forwarded-For pour
# déterminer l'IP réelle du client (anti-brute-force par IP sur l'authentification).
# Défaut : ne fait confiance qu'aux proxys sur adresses privées/loopback (le
# reverse-proxy Caddy co-localisé) — une connexion publique directe voit son
# X-Forwarded-For ignoré. Valeurs possibles : "false", "true", un nombre de
# sauts, ou une liste d'IP/sous-réseaux séparés par virgules. Optionnel — à
# ajuster seulement si la topologie réseau diffère du défaut.
# TRUST_PROXY=loopback,linklocal,uniquelocal

# Version applicative déployée, normalement stampée automatiquement dans .env
# par install.sh (à partir de src/elium/__init__.py) et exposée sur
# /api/health pour que l'auto-updater VPS puisse confirmer la version en
# cours. Optionnel — vaut "dev" quand absent (npm run dev en local).
# ELIUM_VERSION=dev

# Écriture-retour de signature (POST /links/:token/sign) : route PUBLIQUE, non
# authentifiée, scellée par un simple token — plafond dédié en octets, bien
# en deçà du blob générique (MAX_BLOB_BYTES), pour limiter l'exposition que
# peut consommer un token de signature qui fuiterait. Optionnel — 50 Mo par défaut.
# MAX_SIGN_ARTIFACT_BYTES=52428800

# Bornes anti-DoS du relais de collaboration temps réel (CRDT Yjs relayé en
# aveugle). Taille max d'un update chiffré en octets (le ciphertext hex
# occupe 2x cette taille sur le fil), débit max de messages par seconde et
# par connexion, et nombre max de connexions WebSocket simultanées par
# utilisateur (onglets/appareils/documents multiples). Optionnelles — valeurs
# par défaut raisonnables.
# MAX_COLLAB_MESSAGE_BYTES=524288
# MAX_COLLAB_MESSAGES_PER_SEC=300
# MAX_COLLAB_CONNECTIONS_PER_USER=40

# WebAuthn (2e facteur / passkeys). rpId = domaine effectif, SANS schéma ni
# port ("localhost" en dev). L'origine attendue lors des cérémonies est la
# liste CORS_ORIGINS, car c'est là que navigator.credentials s'exécute. DOIT
# être le domaine réel du Drive en production (ex. "edit.nmty.fr"), sinon les
# cérémonies WebAuthn échouent (le rpId ne correspond plus à l'origine réelle
# vue par le navigateur/l'authentificateur).
WEBAUTHN_RP_ID=localhost
# Nom affiché par le navigateur/l'authentificateur lors de l'enregistrement
# d'une passkey. Purement cosmétique — optionnel.
# WEBAUTHN_RP_NAME=Elium Drive

# Scalabilité horizontale (OPTIONNELLE). Sans REDIS_URL, le serveur tourne en
# mono-instance : le relais collab, le canal d'événements org et le
# rate-limit vivent en mémoire de process (comportement historique, aucune
# fonctionnalité perdue en mono-instance). Avec REDIS_URL renseigné, un
# backplane Redis (pub/sub) propage broadcast/kick/notifyOrg à toutes les
# instances et le rate-limit devient partagé — nécessaire seulement pour un
# déploiement multi-instance. Ex. redis://127.0.0.1:6379
# REDIS_URL=

# Lue par src/server.ts (pas config.ts) : applique automatiquement les
# migrations SQL au démarrage du serveur (npm run dev / npm start). Mettre à
# "false" pour désactiver (ex. migration lancée séparément par le pipeline de
# déploiement) ; toute autre valeur (ou absence) exécute les migrations.
# Optionnel — activé par défaut.
# RUN_MIGRATIONS=true
