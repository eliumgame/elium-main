{
  "name": "elium-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Elium Drive Entreprise — zero-knowledge E2E API + collaboration relay (Fastify).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "@simplewebauthn/server": "^13.3.2",
    "fastify": "5.12.7",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true
  },
  "overrides": {
    "fast-uri": "4.1.4"
  }
}
